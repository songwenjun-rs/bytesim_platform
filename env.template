# bytesim platform — environment variable template
# =================================================
#
# Single source of truth for every env var the 8 runtime services read.
# Copy + customise per environment:
#
#   cp env.template .env.local        # dev (.env.local is gitignored)
#   cp env.template /etc/bytesim/env   # systemd EnvironmentFile
#   # for k8s, render into ConfigMap (non-secret) + Secret (secret) — see end.
#
# Convention markers:
#   # REQUIRED — must be set, no usable default for prod
#   # OPTIONAL — has a default; only override if you need to
#   # SECRET   — must never enter version control or unencrypted logs
#
# Every value below is the docker-compose default. Override for cross-host:
#   - docker-compose service-name → k8s Service DNS / LB endpoint / IP:port


# ─────────────────────────────────────────────────────────────────────
# Postgres (shared by data_svc, engine_registry_svc, tco_engine_svc)
# ─────────────────────────────────────────────────────────────────────

# REQUIRED / SECRET — Postgres DSN. data_svc uses PG_DSN; the two PG-touching
# Python services use BYTESIM_PG_DSN. Point them at the SAME database
# (different names are historical; consolidating is a separate cleanup).
PG_DSN=postgres://bytesim:bytesim@postgres:5432/bytesim?sslmode=disable
BYTESIM_PG_DSN=postgres://bytesim:bytesim@postgres:5432/bytesim


# ─────────────────────────────────────────────────────────────────────
# data_svc (Go · port 8081)
# ─────────────────────────────────────────────────────────────────────

# OPTIONAL — bind address. healthcheck binary mirrors this for HEALTHCHECK.
LISTEN_ADDR=:8081


# ─────────────────────────────────────────────────────────────────────
# bff (Python FastAPI gateway · port 8080)
# ─────────────────────────────────────────────────────────────────────

# REQUIRED / SECRET — JWT signing key. ALL bff replicas must use the SAME
# value or tokens become unrecognised. Generate with:
#     openssl rand -hex 32
BFF_JWT_SECRET=__REPLACE_ME__use_openssl_rand_hex_32__

# OPTIONAL — token TTL in seconds (default 28800 = 8h)
BFF_JWT_TTL=28800

# OPTIONAL — comma-separated origin allow-list for production CORS.
# Leave unset if browser hits bff via same-origin (nginx reverse-proxies
# /v1/* to bff so the browser sees a single origin).
# Only set when the dashboard is on a different origin from bff.
# BFF_CORS_ORIGINS=https://dashboard.prod.example.com

# OPTIONAL / DEV ONLY — opt-in dev shortcuts. UNSET in prod.
# BFF_ALLOW_DEV_SECRET=1   # bypasses the strong-JWT-secret startup gate
# BFF_ALLOW_DEV_CORS=1     # opens CORS to localhost:5173 (vite dev server)

# REQUIRED — upstream service URLs. Both ASSET_SVC_URL and RUN_SVC_URL
# point at data_svc (historical naming; both refer to the merged service).
ASSET_SVC_URL=http://data_svc:8081
RUN_SVC_URL=http://data_svc:8081
ENGINE_SVC_URL=http://engine_svc:8087
ENGINE_REGISTRY_URL=http://engine_registry_svc:8089
TCO_SVC_URL=http://tco_engine_svc:8090


# ─────────────────────────────────────────────────────────────────────
# engine_svc (Python pipeline orchestrator · port 8087)
# ─────────────────────────────────────────────────────────────────────

# REQUIRED — uses RUN_SVC_URL (data_svc) + ENGINE_REGISTRY_URL (above).
# OPTIONAL — TCO is best-effort; engine_svc continues if TCO is down.
# OPTIONAL — pipeline tunables
# POLL_INTERVAL_S=2                # how often worker_loop polls for queued runs
# ENGINE_PREDICT_TIMEOUT_S=180     # ceiling for a single engine predict call


# ─────────────────────────────────────────────────────────────────────
# engine_registry_svc (Python · port 8089)
# ─────────────────────────────────────────────────────────────────────

# REQUIRED — BYTESIM_PG_DSN (above).
# OPTIONAL — staleness threshold for the engine heartbeat (default 240s).
# ENGINE_REGISTRY_STALE_S=240


# ─────────────────────────────────────────────────────────────────────
# surrogate_svc (Python analytical engine · port 8083)
# ─────────────────────────────────────────────────────────────────────

# REQUIRED — both URLs (registry to register with; data_svc for SKU catalog).
# REQUIRED for cross-host — the URL by which engine_registry_svc reaches
# this engine. Default matches docker-compose service-name; override for
# k8s / bare metal / different hostname.
ENGINE_SELF_URL=http://surrogate_svc:8083


# ─────────────────────────────────────────────────────────────────────
# bytesim_svc (Python ByteSim wrapper · port 8083 — yes, same port as
# surrogate_svc; the two are NEVER on the same host)
# ─────────────────────────────────────────────────────────────────────

# REQUIRED for cross-host — same idea as surrogate_svc. Note: this MUST be
# a different value from surrogate_svc's ENGINE_SELF_URL — set per-service
# in your deployment (k8s Pod env, systemd unit, etc.), not from a shared
# template.
# ENGINE_SELF_URL=http://bytesim_svc:8083


# ─────────────────────────────────────────────────────────────────────
# tco_engine_svc (Python · port 8090)
# ─────────────────────────────────────────────────────────────────────

# REQUIRED — BYTESIM_PG_DSN (above).


# ─────────────────────────────────────────────────────────────────────
# dashboard (nginx serving the SPA · port 80)
# ─────────────────────────────────────────────────────────────────────

# REQUIRED — where nginx reverse-proxies /v1/* (HTTP + WS upgrade).
# Must reach bff over the network; use cluster DNS / LB / IP as appropriate.
BFF_UPSTREAM=bff:8080


# =================================================================
#                       SECRET-HANDLING GUIDE
# =================================================================
#
# Vars marked SECRET above (BFF_JWT_SECRET, PG_DSN, BYTESIM_PG_DSN) must
# NEVER be checked into git. Recommended channels by deployment form:
#
#   dev local           ./env.local                  (gitignored by default)
#   systemd / VM        /etc/bytesim/secrets.env     (chmod 600, owner=root)
#   k8s                 Secret resource + secretKeyRef / envFrom secretRef
#   cloud-managed       AWS Secrets Manager / GCP Secret Manager / Vault,
#                       fetched at pod startup by an init-container or
#                       sidecar that writes to /run/secrets/ and the main
#                       container mounts that path as env.
#
# Rotation:
#   - BFF_JWT_SECRET rotation invalidates all live tokens; do behind a
#     rolling restart, expect users to re-login.
#   - PG passwords rotate via Postgres ALTER USER + new Secret; rolling
#     restart of data_svc / engine_registry_svc / tco_engine_svc.
#
# Multi-replica:
#   - All bff replicas MUST share BFF_JWT_SECRET; mismatch ⇒ 401 chaos.
#   - surrogate_svc / bytesim_svc replicas each need their OWN
#     ENGINE_SELF_URL (the per-pod IP / pod-specific Service DNS) so the
#     registry can route to the right instance.
#
# =================================================================
