# Host B — bff
# All upstream URLs point at the OTHER hosts' published ports via
# host.docker.internal — there is no docker DNS connecting bridges.
BFF_JWT_SECRET=cross-host-validation-secret-do-not-ship-32b
BFF_ALLOW_DEV_CORS=1

ASSET_SVC_URL=http://host.docker.internal:18081
RUN_SVC_URL=http://host.docker.internal:18081
ENGINE_SVC_URL=http://host.docker.internal:18087
# Registry surface lives in engine_svc since the merge — same port.
ENGINE_REGISTRY_URL=http://host.docker.internal:18087
TCO_SVC_URL=http://host.docker.internal:18090
